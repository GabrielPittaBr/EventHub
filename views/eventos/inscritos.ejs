<section class="abertura">
  <h1 class="abertura__titulo">Quem vai a <%= evento.titulo %></h1>
  <p class="abertura__linha">
    <%= evento.inscricoes_confirmadas %> de <%= evento.vagas %> vagas preenchidas. Quem cancela
    sai da lista e libera a vaga.
  </p>

  <div class="acoes abertura__acoes">
    <a class="botao botao--secundario" href="/painel">Voltar para meus eventos</a>
    <a class="botao botao--secundario" href="/eventos/<%= evento.id %>">Ver a página do evento</a>
  </div>
</section>

<% if (inscritos.length === 0) { %>
  <div class="vazio">
    <p>Ninguém se inscreveu ainda. Compartilhe o link da página do evento para começar a encher.</p>
    <a class="botao botao--secundario" href="/eventos/<%= evento.id %>">Abrir a página do evento</a>
  </div>
<% } else { %>
  <div class="tabela-wrapper">
    <table class="tabela">
      <thead>
        <tr>
          <th scope="col">Nome</th>
          <th scope="col">E-mail</th>
          <th scope="col">Situação</th>
          <th scope="col">Inscrito em</th>
        </tr>
      </thead>
      <tbody>
        <% inscritos.forEach(function (inscrito) { %>
          <tr>
            <td><%= inscrito.nome %></td>
            <td><%= inscrito.email %></td>
            <td>
              <span class="selo selo--<%= inscrito.status %>"><%= inscrito.status %></span>
            </td>
            <td class="data"><%= formatarDataHora(inscrito.criado_em) %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>
