<section class="destaque">
  <h1><%= evento.titulo %></h1>
  <p class="destaque__texto">Organizado por <%= evento.organizador_nome %>.</p>
</section>

<article class="cartao">
  <dl class="cartao__dados">
    <div>
      <dt>Inicio</dt>
      <dd><%= formatarDataHora(evento.data_inicio) %></dd>
    </div>
    <div>
      <dt>Termino</dt>
      <dd><%= formatarDataHora(evento.data_fim) %></dd>
    </div>
    <div>
      <dt>Local</dt>
      <dd><%= evento.local %></dd>
    </div>
    <div>
      <dt>Vagas</dt>
      <dd><%= evento.vagas_restantes %> restantes de <%= evento.vagas %></dd>
    </div>
  </dl>

  <h2 class="cartao__titulo">Sobre o evento</h2>
  <p><%= evento.descricao %></p>

  <% if (inscricao) { %>
    <p class="cartao__status">
      Sua inscricao:
      <span class="selo selo--<%= inscricao.status %>"><%= inscricao.status %></span>
    </p>
  <% } %>

  <div class="acoes">
    <a class="botao botao--secundario" href="/">Voltar para os eventos</a>

    <%# Esconder o botao nao substitui a checagem do servidor, que roda no POST. %>
    <% if (usuario && usuario.id === evento.organizador_id) { %>
      <a class="botao botao--primario" href="/eventos/<%= evento.id %>/editar">Editar evento</a>
      <a class="botao botao--secundario" href="/eventos/<%= evento.id %>/inscritos">Ver inscritos</a>
    <% } else if (inscricao && inscricao.status === 'confirmada') { %>
      <form action="/inscricoes/<%= inscricao.id %>?_method=DELETE" method="POST">
        <button class="botao botao--perigo" type="submit">Cancelar inscricao</button>
      </form>
    <% } else if (inscricoesEncerradas) { %>
      <span class="selo selo--indisponivel">Inscricoes encerradas</span>
    <% } else if (evento.vagas_restantes <= 0) { %>
      <span class="selo selo--indisponivel">Evento lotado</span>
    <% } else if (usuario) { %>
      <form action="/eventos/<%= evento.id %>/inscricoes" method="POST">
        <button class="botao botao--primario" type="submit">Inscrever-se</button>
      </form>
    <% } else { %>
      <a class="botao botao--primario" href="/auth/login">Entre para se inscrever</a>
    <% } %>
  </div>
</article>
