<section class="abertura">
  <h1 class="abertura__titulo"><%= editando ? 'Editar evento' : 'Publicar evento' %></h1>
  <p class="abertura__linha">
    É isto que os participantes veem na página do evento e o que decide se eles se inscrevem.
  </p>
</section>

<form
  class="formulario"
  action="<%= editando ? '/eventos/' + id + '?_method=PUT' : '/eventos' %>"
  method="POST"
  novalidate
>
  <div class="campo-grupo">
    <label for="titulo">Título</label>
    <input
      class="campo <%= erros.titulo ? 'campo--invalido' : '' %>"
      type="text"
      id="titulo"
      name="titulo"
      value="<%= valores.titulo %>"
      maxlength="160"
      required
    />
    <% if (erros.titulo) { %>
      <span class="campo-erro"><%= erros.titulo %></span>
    <% } %>
  </div>

  <div class="campo-grupo">
    <label for="descricao">Descrição</label>
    <textarea
      class="campo <%= erros.descricao ? 'campo--invalido' : '' %>"
      id="descricao"
      name="descricao"
      maxlength="5000"
      required
    ><%= valores.descricao %></textarea>
    <% if (erros.descricao) { %>
      <span class="campo-erro"><%= erros.descricao %></span>
    <% } else { %>
      <span class="campo-ajuda">Conte o que acontece no evento, para quem é e o que levar.</span>
    <% } %>
  </div>

  <div class="campo-grupo">
    <label for="local">Local</label>
    <input
      class="campo <%= erros.local ? 'campo--invalido' : '' %>"
      type="text"
      id="local"
      name="local"
      value="<%= valores.local %>"
      maxlength="160"
      required
    />
    <% if (erros.local) { %>
      <span class="campo-erro"><%= erros.local %></span>
    <% } else { %>
      <span class="campo-ajuda">Onde as pessoas devem chegar, como "Auditório do bloco B".</span>
    <% } %>
  </div>

  <div class="campo-grupo">
    <label for="dataInicio">Início</label>
    <input
      class="campo <%= erros.dataInicio ? 'campo--invalido' : '' %>"
      type="datetime-local"
      id="dataInicio"
      name="dataInicio"
      value="<%= valores.dataInicio %>"
      required
    />
    <% if (erros.dataInicio) { %>
      <span class="campo-erro"><%= erros.dataInicio %></span>
    <% } else { %>
      <span class="campo-ajuda">As inscrições fecham sozinhas quando o evento começa.</span>
    <% } %>
  </div>

  <div class="campo-grupo">
    <label for="dataFim">Término</label>
    <input
      class="campo <%= erros.dataFim ? 'campo--invalido' : '' %>"
      type="datetime-local"
      id="dataFim"
      name="dataFim"
      value="<%= valores.dataFim %>"
      required
    />
    <% if (erros.dataFim) { %>
      <span class="campo-erro"><%= erros.dataFim %></span>
    <% } %>
  </div>

  <div class="campo-grupo">
    <label for="vagas">Vagas</label>
    <input
      class="campo <%= erros.vagas ? 'campo--invalido' : '' %>"
      type="number"
      id="vagas"
      name="vagas"
      value="<%= valores.vagas %>"
      min="1"
      step="1"
      required
    />
    <% if (erros.vagas) { %>
      <span class="campo-erro"><%= erros.vagas %></span>
    <% } else { %>
      <span class="campo-ajuda">Quantas pessoas cabem. Um número inteiro maior que zero.</span>
    <% } %>
  </div>

  <div class="acoes">
    <button class="botao botao--primario" type="submit">
      <%= editando ? 'Salvar alterações' : 'Publicar evento' %>
    </button>
    <a class="botao botao--texto" href="/painel">Cancelar</a>
  </div>
</form>
