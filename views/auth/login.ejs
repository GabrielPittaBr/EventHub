<section class="abertura">
  <h1 class="abertura__titulo">Entrar</h1>
  <p class="abertura__linha">
    Acesse a sua conta para publicar eventos ou acompanhar as suas inscrições.
  </p>
</section>

<form class="formulario" action="/auth/login" method="POST" novalidate>
  <div class="campo-grupo">
    <label for="email">E-mail</label>
    <input
      class="campo <%= erros.email ? 'campo--invalido' : '' %>"
      type="email"
      id="email"
      name="email"
      value="<%= valores.email %>"
      maxlength="180"
      autocomplete="email"
      required
    />
    <% if (erros.email) { %>
      <span class="campo-erro"><%= erros.email %></span>
    <% } %>
  </div>

  <div class="campo-grupo">
    <label for="senha">Senha</label>
    <input
      class="campo <%= erros.senha ? 'campo--invalido' : '' %>"
      type="password"
      id="senha"
      name="senha"
      autocomplete="current-password"
      required
    />
    <% if (erros.senha) { %>
      <span class="campo-erro"><%= erros.senha %></span>
    <% } %>
  </div>

  <div class="acoes">
    <button class="botao botao--primario" type="submit">Entrar</button>
    <a class="botao botao--texto" href="/auth/registrar">Criar uma conta</a>
  </div>
</form>
