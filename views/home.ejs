<%
  const vagasLivres = eventos.reduce(function (soma, evento) {
    return soma + Math.max(0, Number(evento.vagas_restantes) || 0);
  }, 0);
%>

<section class="abertura">
  <h1 class="abertura__titulo">Eventos abertos</h1>
  <p class="abertura__linha">
    <% if (eventos.length === 0) { %>
      Nada aberto no momento.
    <% } else { %>
      <%= eventos.length %> <%= eventos.length === 1 ? 'evento' : 'eventos' %> com inscrição
      aberta e <%= vagasLivres %> <%= vagasLivres === 1 ? 'vaga livre' : 'vagas livres' %>.
    <% } %>
  </p>

  <form class="busca" action="/" method="GET" role="search">
    <label class="rotulo-oculto" for="busca">Buscar evento pelo título</label>
    <input
      class="campo"
      type="search"
      id="busca"
      name="busca"
      value="<%= busca %>"
      placeholder="Buscar pelo título"
      maxlength="160"
    />
    <button class="botao botao--primario" type="submit">Buscar</button>
    <% if (busca) { %>
      <a class="botao botao--texto" href="/">Limpar</a>
    <% } %>
  </form>
</section>

<% if (eventos.length === 0) { %>
  <div class="vazio">
    <% if (busca) { %>
      <p>Nenhum evento aberto tem "<%= busca %>" no título.</p>
      <a class="botao botao--secundario" href="/">Ver todos os eventos</a>
    <% } else { %>
      <p>Nenhum evento com inscrição aberta agora. Os próximos aparecem aqui assim que forem publicados.</p>
    <% } %>
  </div>
<% } else { %>
  <ul class="lista-eventos">
    <% eventos.forEach(function (evento) { %>
      <% const data = partesDaData(evento.data_inicio); %>
      <li class="evento">
        <p class="evento__data">
          <span class="evento__dia"><%= data ? data.dia : '--' %></span>
          <span class="evento__mes"><%= data ? data.mes : '' %></span>
          <span class="evento__ano"><%= data ? data.ano : '' %></span>
        </p>

        <div class="evento__corpo">
          <h2 class="evento__titulo">
            <a href="/eventos/<%= evento.id %>"><%= evento.titulo %></a>
          </h2>
          <p class="evento__onde">
            <%= evento.local %><% if (data) { %>, às <%= data.hora %><% } %>
          </p>
        </div>

        <div class="evento__vagas">
          <%- include('partials/vagas', { vagas: evento.vagas, restantes: evento.vagas_restantes }) %>
        </div>
      </li>
    <% }); %>
  </ul>
<% } %>
