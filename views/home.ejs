<section class="destaque">
  <h1>Eventos abertos para inscricao</h1>
  <p class="destaque__texto">
    Encontre eventos academicos e corporativos, veja as vagas disponiveis e garanta a sua.
  </p>

  <form class="busca" action="/" method="GET">
    <label class="rotulo-oculto" for="busca">Buscar por titulo</label>
    <input
      class="campo"
      type="search"
      id="busca"
      name="busca"
      value="<%= busca %>"
      placeholder="Buscar por titulo"
      maxlength="160"
    />
    <button class="botao botao--primario" type="submit">Buscar</button>
    <% if (busca) { %>
      <a class="botao botao--texto" href="/">Limpar</a>
    <% } %>
  </form>
</section>

<% if (eventos.length === 0) { %>
  <p class="vazio">
    <% if (busca) { %>
      Nenhum evento futuro encontrado para "<%= busca %>". Tente outro termo ou veja todos os eventos.
    <% } else { %>
      Nenhum evento futuro publicado por enquanto. Volte em breve.
    <% } %>
  </p>
<% } else { %>
  <ul class="grade-eventos">
    <% eventos.forEach(function (evento) { %>
      <li class="cartao">
        <h2 class="cartao__titulo"><%= evento.titulo %></h2>
        <dl class="cartao__dados">
          <div>
            <dt>Quando</dt>
            <dd><%= formatarDataHora(evento.data_inicio) %></dd>
          </div>
          <div>
            <dt>Onde</dt>
            <dd><%= evento.local %></dd>
          </div>
          <div>
            <dt>Vagas restantes</dt>
            <dd><%= evento.vagas_restantes %> de <%= evento.vagas %></dd>
          </div>
        </dl>
        <a class="botao botao--secundario" href="/eventos/<%= evento.id %>">Ver detalhes</a>
      </li>
    <% }); %>
  </ul>
<% } %>
