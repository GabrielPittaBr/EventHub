<header class="cabecalho">
  <div class="container cabecalho__interno">
    <a class="marca" href="/">Event<span>Hub</span></a>

    <nav class="navegacao" aria-label="Navegação principal">
      <a
        class="navegacao__link"
        href="/"
        <%- caminhoAtual === '/' ? 'aria-current="page"' : '' %>
      >Eventos</a>

      <% if (usuario) { %>
        <% if (usuario.papel === 'organizador') { %>
          <a
            class="navegacao__link"
            href="/painel"
            <%- caminhoAtual === '/painel' ? 'aria-current="page"' : '' %>
          >Meus eventos</a>
        <% } else { %>
          <a
            class="navegacao__link"
            href="/minhas-inscricoes"
            <%- caminhoAtual === '/minhas-inscricoes' ? 'aria-current="page"' : '' %>
          >Minhas inscrições</a>
        <% } %>
        <span class="navegacao__usuario"><%= usuario.nome %></span>
        <form class="navegacao__form" action="/auth/logout" method="POST">
          <button class="botao botao--texto" type="submit">Sair</button>
        </form>
      <% } else { %>
        <a
          class="navegacao__link"
          href="/auth/login"
          <%- caminhoAtual === '/auth/login' ? 'aria-current="page"' : '' %>
        >Entrar</a>
        <a class="botao botao--secundario" href="/auth/registrar">Criar conta</a>
      <% } %>
    </nav>
  </div>
</header>
