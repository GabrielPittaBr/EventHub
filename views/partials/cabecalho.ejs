<header class="cabecalho">
  <div class="container cabecalho__interno">
    <a class="marca" href="/">Event<span>Hub</span></a>

    <nav class="navegacao">
      <a class="navegacao__link" href="/">Eventos</a>

      <% if (usuario) { %>
        <% if (usuario.papel === 'organizador') { %>
          <a class="navegacao__link" href="/painel">Painel</a>
        <% } else { %>
          <a class="navegacao__link" href="/minhas-inscricoes">Minhas inscrições</a>
        <% } %>
        <span class="navegacao__usuario">Olá, <%= usuario.nome %></span>
        <form class="navegacao__form" action="/auth/logout" method="POST">
          <button class="botao botao--texto" type="submit">Sair</button>
        </form>
      <% } else { %>
        <a class="navegacao__link" href="/auth/login">Entrar</a>
        <a class="botao botao--primario" href="/auth/registrar">Criar conta</a>
      <% } %>
    </nav>
  </div>
</header>
