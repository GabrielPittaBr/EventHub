<section class="abertura">
  <h1 class="abertura__titulo">Minhas inscrições</h1>
  <p class="abertura__linha">
    Os eventos em que você garantiu vaga, dos mais próximos aos já realizados.
  </p>
</section>

<% if (inscricoes.length === 0) { %>
  <div class="vazio">
    <p>Você ainda não tem inscrições. Escolha um evento aberto e garanta a sua vaga.</p>
    <a class="botao botao--primario" href="/">Ver eventos abertos</a>
  </div>
<% } else { %>
  <div class="tabela-wrapper">
    <table class="tabela">
      <thead>
        <tr>
          <th scope="col">Evento</th>
          <th scope="col">Início</th>
          <th scope="col">Local</th>
          <th scope="col">Situação</th>
          <th scope="col" class="tabela__acoes">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% inscricoes.forEach(function (inscricao) { %>
          <tr>
            <td><a href="/eventos/<%= inscricao.evento_id %>"><%= inscricao.titulo %></a></td>
            <td class="data"><%= formatarDataHora(inscricao.data_inicio) %></td>
            <td><%= inscricao.local %></td>
            <td>
              <span class="selo selo--<%= inscricao.status %>"><%= inscricao.status %></span>
            </td>
            <td class="tabela__acoes">
              <div class="acoes">
                <a class="botao botao--secundario" href="/eventos/<%= inscricao.evento_id %>">
                  Ver evento
                </a>
                <% if (inscricao.status === 'confirmada') { %>
                  <form
                    action="/inscricoes/<%= inscricao.id %>?_method=DELETE"
                    method="POST"
                    data-confirmar="Cancelar a sua inscrição em <%= inscricao.titulo %>? A vaga volta para a fila."
                  >
                    <button class="botao botao--perigo" type="submit">Cancelar</button>
                  </form>
                <% } %>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
<% } %>
