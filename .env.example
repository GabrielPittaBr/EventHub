# Copie este arquivo para .env e preencha com os valores reais.
# O .env NAO deve ser versionado.

# Ambiente de execucao: development | production
NODE_ENV=development

# Porta HTTP local. Em producao o Render define esta variavel automaticamente.
PORT=3000

# --- Banco de dados MySQL (Aiven) ---
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=eventhub_db

# Certificado CA da Aiven: caminho para o arquivo .pem OU o conteudo do certificado.
# Deixe vazio para MySQL local (sem TLS). Obrigatorio na Aiven/producao.
DB_SSL_CA=

# --- Sessao ---
# String longa e aleatoria. Gere uma diferente para producao.
SESSION_SECRET=
